# 🔐 FANTASY ML AUTHENTICATION SYSTEM - ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# MASTER ENCRYPTION KEY (CRITICAL)
# =============================================================================
# Used to encrypt all stored credentials. Must be 32+ characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FANTASY_ML_MASTER_KEY=your-super-secure-master-key-here-32-characters-minimum

# =============================================================================
# DRAFTKINGS OAUTH2 CONFIGURATION
# =============================================================================
# Obtain these from DraftKings Developer Portal
DRAFTKINGS_CLIENT_ID=your_draftkings_client_id_here
DRAFTKINGS_CLIENT_SECRET=your_draftkings_client_secret_here
DRAFTKINGS_REDIRECT_URI=http://localhost:3000/auth/draftkings/callback

# =============================================================================
# FANDUEL OAUTH2 CONFIGURATION  
# =============================================================================
# Obtain these from FanDuel Developer Portal
FANDUEL_CLIENT_ID=your_fanduel_client_id_here
FANDUEL_CLIENT_SECRET=your_fanduel_client_secret_here
FANDUEL_REDIRECT_URI=http://localhost:3000/auth/fanduel/callback

# =============================================================================
# SMS PROVIDER CONFIGURATION (Optional - for 2FA)
# =============================================================================
# Configure if you want SMS 2FA support
# Example providers: Twilio, AWS SNS, etc.
SMS_PROVIDER_API_KEY=your_sms_provider_api_key
SMS_PROVIDER_ACCOUNT_SID=your_sms_account_sid
SMS_FROM_NUMBER=+1234567890

# =============================================================================
# DATABASE CONFIGURATION (If using persistent storage)
# =============================================================================
DATABASE_URL=postgresql://username:password@localhost:5432/fantasy_ml
DATABASE_URL_LOCAL=postgresql://username:password@localhost:5432/fantasy_ml

# =============================================================================
# SECURITY SETTINGS (Optional)
# =============================================================================
# Session timeout in seconds (default: 3600 = 1 hour)
SESSION_TIMEOUT=3600

# 2FA settings
TOTP_WINDOW=2
TOTP_STEP=30

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Set to 'development' for additional logging
NODE_ENV=development

# Enable debug logging
DEBUG=auth:*

# API ports
FANTASY_API_PORT=3338

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
# In production, also set:
# - Use HTTPS for all redirect URIs
# - Enable secure cookie settings
# - Configure proper CORS origins
# - Set up monitoring and alerting
# - Use environment-specific master keys
# - Enable audit logging