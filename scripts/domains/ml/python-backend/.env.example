# 🔥 FANTASY ML PYTHON BACKEND CONFIGURATION - NO CORNERS CUT! 🚀
# RTX 4060 + CUDA 12.8 + Professional GPU Acceleration

# Python Environment
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# GPU Acceleration - RTX 4060 Optimized
XGB_USE_CUDA=1
NVIDIA_TF32_OVERRIDE=1
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=0

# Directories
MODEL_DIR=/app/python-backend/models/saved
CACHE_DIR=/app/python-backend/data/cache
LOG_LEVEL=INFO

# Database Configuration (WSL2 → Windows PostgreSQL)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=fantasy_ai_local
DB_USER=postgres
DB_PASSWORD=postgres
DB_MAX_CONNECTIONS=10
DB_TIMEOUT=30

# Performance Optimization - Ryzen 5 7600X
OMP_NUM_THREADS=6
MKL_NUM_THREADS=6
NUMBA_NUM_THREADS=6

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_LOG_LEVEL=info

# ML Configuration
DEFAULT_MONTE_CARLO_ITERATIONS=10000
MAX_LINEUP_GENERATION=150
GPU_MEMORY_FRACTION=0.8

# Development
DEBUG=false
TESTING=false