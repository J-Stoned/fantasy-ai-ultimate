# Database
DATABASE_URL_LOCAL=postgresql://postgres:postgres@localhost:5432/fantasy_ml
DATABASE_URL=your-supabase-url

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Redis Cluster Configuration (for production)
REDIS_CLUSTERS=localhost:7000,localhost:7001,localhost:7002
# Enable Redis Session Management
REDIS_SESSION_ENABLED=true

# JWT Configuration
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=7d

# WebSocket Configuration
WEBSOCKET_PORT=3001
WEBSOCKET_PATH=/ws
ENABLE_WEBSOCKET=true

# Queue Configuration
ENABLE_QUEUE=true

# OAuth Configuration
ENABLE_OAUTH=true

# Yahoo Fantasy OAuth
YAHOO_CLIENT_ID=your-yahoo-client-id
YAHOO_CLIENT_SECRET=your-yahoo-client-secret

# ESPN Fantasy OAuth
ESPN_CLIENT_ID=your-espn-client-id
ESPN_CLIENT_SECRET=your-espn-client-secret

# Sleeper OAuth
SLEEPER_CLIENT_ID=your-sleeper-client-id
SLEEPER_CLIENT_SECRET=your-sleeper-client-secret

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
API_TIMEOUT=30000

# External APIs
SPORTSDATA_KEY=your-sportsdata-key
SPORTSDATA_API_KEY=your-sportsdata-api-key  # For player photos
OPENWEATHER_KEY=your-openweather-key
ODDS_API_KEY=your-odds-api-key

# Avatar Services
NEXT_PUBLIC_ELEVENLABS_API_KEY=your-elevenlabs-key
NEXT_PUBLIC_ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB  # Adam voice
STABLE_DIFFUSION_API_KEY=your-sd-api-key  # For 2D sprite generation
KAEDIM_API_KEY=your-kaedim-key  # For 3D model generation

# DFS Platform APIs
DK_OWNERSHIP_API=https://api.draftkings.com/ownership
FD_OWNERSHIP_API=https://api.fanduel.com/ownership

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Next Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

# Admin Authentication
# SECURITY: Generate strong values for production!
# To generate password hash: npm run admin:hash-password
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=generate-bcrypt-hash-using-script
ADMIN_PASSWORD_IS_SHA256=false  # Set to "true" if still using legacy SHA-256
ADMIN_MFA_SECRET=generate-6-digit-totp-secret
ADMIN_SESSION_SECRET=generate-random-64-char-string
ADMIN_ID=generate-unique-admin-id
BCRYPT_SALT_ROUNDS=12  # Recommended: 12-14 for production