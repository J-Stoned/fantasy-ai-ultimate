# Production Environment Variables Template
# Copy this to .env.production and fill in your values

# Database Configuration (Required)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
POSTGRES_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Security Keys (Required - Generate secure random strings)
JWT_SECRET=your-32-character-secure-jwt-secret-here
ENCRYPTION_KEY=your-32-character-encryption-key-here
SESSION_SECRET=your-32-character-session-secret-here
ADMIN_PASSWORD=your-secure-admin-password-here

# Application URLs (Update with your Vercel domain)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_API_URL=https://your-app.vercel.app/api
NEXT_PUBLIC_WS_URL=wss://your-app.vercel.app

# Optional External Services
REDIS_URL=redis://default:password@host:6379
OPENAI_API_KEY=sk-your-openai-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# Monitoring & Analytics (Optional)
LOG_AGGREGATION_ENDPOINT=https://your-logging-service.com
LOG_SERVICE_TOKEN=your-logging-token
SENTRY_DSN=https://your-sentry-dsn

# Feature Flags
NEXT_PUBLIC_ENABLE_ML=false
NEXT_PUBLIC_ENABLE_VOICE=false
NEXT_PUBLIC_ENABLE_3D_AVATARS=false
REDIS_SESSION_ENABLED=false

# Performance Settings
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1