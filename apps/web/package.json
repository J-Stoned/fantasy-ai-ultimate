{
  "name": "@fantasy-ai/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "services": "tsx scripts/start-services.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run services\"",
    "worker": "tsx src/lib/workers/init.ts",
    "websocket": "tsx src/lib/services/websocket-server.ts",
    "admin:hash-password": "tsx scripts/hash-password.ts",
    "analyze": "ANALYZE=true next build",
    "analyze:server": "BUNDLE_ANALYZE=server next build",
    "analyze:browser": "BUNDLE_ANALYZE=browser next build",
    "db:optimize": "tsx src/lib/database/init-optimizations.ts",
    "db:monitor": "tsx scripts/query-monitor.ts",
    "db:migrate": "psql -U postgres -d fantasy_ai_local -f src/lib/database/migrations/001_optimize_indexes.sql",
    "logs:replace-console": "tsx scripts/replace-console-logs.ts",
    "logs:audit": "grep -r \"console\\.\" src/ --include=\"*.ts\" --include=\"*.tsx\" | wc -l",
    "errors:test": "tsx scripts/test-error-handling.ts",
    "health:check": "tsx scripts/health-check.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=__tests__/unit",
    "test:integration": "jest --testPathPattern=__tests__/integration",
    "test:components": "jest --testPathPattern=__tests__/components",
    "test:e2e": "playwright test",
    "test:performance": "tsx scripts/test-performance.ts",
    "test:e2e:full": "tsx scripts/e2e-full-journey.test.ts",
    "test:e2e:mobile": "tsx scripts/e2e-mobile-gestures.test.ts",
    "test:ultimate": "tsx scripts/test-with-firecrawl-puppeteer.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test:coverage && npm run test:e2e",
    "test:ci": "npm run test:coverage -- --ci --watchAll=false && npm run test:e2e",
    "playwright:install": "playwright install",
    "avatars:check": "tsx scripts/check-avatar-migration.ts",
    "avatars:migrate": "tsx scripts/run-avatar-migration.ts",
    "avatars:populate": "tsx scripts/populate-player-avatars-local.ts",
    "avatars:fetch-photos": "tsx scripts/fetch-player-photos.ts",
    "avatars:generate": "tsx scripts/generate-missing-avatars.ts"
  },
