# Local PostgreSQL Configuration (10x Performance!)
# For local development with 72x faster queries
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/fantasy_ai_local
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fantasy_ai_local
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_POOL_MIN=10
DATABASE_POOL_MAX=100

# Direct connection URL (for migrations/admin tasks)
DIRECT_URL=postgresql://postgres:your_password@localhost:5432/fantasy_ai_local

# Supabase Configuration (Optional - for cloud backup)
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Sports API Keys
BALLDONTLIE_API_KEY=your-api-key
MYSPORTSFEEDS_API_KEY=your-api-key
SPORTRADAR_API_KEY=your-api-key
RAPIDAPI_KEY=your-rapidapi-key
ODDS_API_KEY=your-odds-api-key

# Fantasy Platform OAuth
YAHOO_CLIENT_ID=your-client-id
YAHOO_CLIENT_SECRET=your-client-secret
ESPN_API_KEY=your-api-key
SLEEPER_API_KEY=your-api-key

# AI Configuration
OPENAI_API_KEY=your-api-key
ELEVENLABS_API_KEY=your-api-key

# Other Services
WEATHER_API_KEY=your-api-key
NEWS_API_KEY=your-api-key
SENTRY_DSN=your-sentry-dsn

# Production Security
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
CSRF_SECRET=generate-with-openssl-rand-base64-32# Add your Anthropic API key here for enhanced AI capabilities
ANTHROPIC_API_KEY=your_key_here
